# Copy this file to .env (git ignores .env) or run: jobpipe init --contact you@example.org

# Required: your e-mail address. jobpipe sends it in the User-Agent of every request so that a
# site can contact you about the traffic. Never use someone else's address.
JOBPIPE_CONTACT=

# Optional: a free Adzuna API key (https://developer.adzuna.com) adds Adzuna to the sources.
# Without it, Adzuna is skipped and everything else works.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
